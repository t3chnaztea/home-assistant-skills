#!/bin/sh
# Validate staged SKILL.md files against the Agent Skills spec before committing.
# Enable in a fresh clone with:  git config core.hooksPath .githooks

# ':(glob)**/SKILL.md' matches SKILL.md at the root and in any subdirectory.
pathspec=':(glob)**/SKILL.md'
[ -z "$(git diff --cached --name-only --diff-filter=ACM -- "$pathspec")" ] && exit 0

script="$(git rev-parse --show-toplevel)/.github/scripts/validate_skills.py"
[ -f "$script" ] || exit 0

# PyYAML is required. Prefer a python3 that already has it; otherwise use uv,
# which fetches it into a throwaway env without touching the system install.
if python3 -c 'import yaml' 2>/dev/null; then
  run="python3"
elif command -v uv >/dev/null 2>&1; then
  run="uv run --quiet --with pyyaml python3"
else
  echo "pre-commit: skipping SKILL.md validation (no PyYAML and no uv)." >&2
  exit 0
fi

# Validate the staged (index) copies, not the working tree: export them into a
# temp dir with their paths intact (the name/parent-dir check needs the path).
# NUL-delimited so paths with spaces survive.
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
git diff --cached -z --name-only --diff-filter=ACM -- "$pathspec" |
  xargs -0 git checkout-index --prefix="$tmp/" -- || exit 1

# shellcheck disable=SC2086
(cd "$tmp" && $run "$script" .) || {
  echo >&2
  echo "pre-commit: SKILL.md failed spec validation. Fix the errors above, or bypass with --no-verify." >&2
  exit 1
}
